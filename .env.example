# Base de datos
# DB_USER y DB_PASSWORD: valores dummy para desarrollo local únicamente.
# Cambiar en producción, no usar estos valores.
DB_HOST=postgres
DB_USER=dev
DB_PASSWORD=dev
DB_NAME=ruleta_pozo_acumulado
DB_PORT=5432

# Usada por Prisma (migraciones, seed, cliente en runtime desde V0.3).
# Debe coincidir con las variables de arriba si se usa docker-compose.
DATABASE_URL=postgresql://dev:dev@localhost:5432/ruleta_pozo_acumulado

# Auth / JWT
JWT_SECRET=
JWT_SECRET_PREVIOUS=
REFRESH_TOKEN_PEPPER=
# Pepper del hash de tokens de verificación de email — deliberadamente
# distinto de REFRESH_TOKEN_PEPPER (ver auth/tokens.ts): son dos clases de
# secreto con ciclos de vida distintos, y rotar uno no debe invalidar el
# otro como efecto secundario no buscado.
EMAIL_TOKEN_PEPPER=

# Email
EMAIL_PROVIDER_KEY=
# V0.3 NO integra un proveedor de email real. En NODE_ENV=development, los
# emails se imprimen a stdout como JSON estructurado (ver
# src/modules/audit/mailer.ts). Fuera de development, enviar un email
# lanza un error explícito en vez de fingir que se envió.

# App
APP_BASE_URL=http://localhost:5173
NODE_ENV=development
PORT=3000

# Reglas de juego (J.1-J.3, ver docs/spec) - valores por defecto, no secretos
CONTRIBUTION_AMOUNT=1
GOLD_PROBABILITY_DENOMINATOR=100000
POT_MINIMUM=100
