# Base de datos
# DB_USER y DB_PASSWORD: valores dummy para desarrollo local únicamente.
# Cambiar en producción, no usar estos valores.
DB_HOST=postgres
DB_USER=dev
DB_PASSWORD=dev
DB_NAME=ruleta_pozo_acumulado
DB_PORT=5432

# Prisma la usará en V0.3; ajustar según el entorno (host, usuario,
# contraseña y nombre de base de datos deben coincidir con las variables de
# arriba si se usa docker-compose).
DATABASE_URL=postgresql://user:password@postgres:5432/ruleta_pozo_acumulado

# Auth / JWT
JWT_SECRET=
JWT_SECRET_PREVIOUS=
REFRESH_TOKEN_PEPPER=

# Email
EMAIL_PROVIDER_KEY=

# App
APP_BASE_URL=http://localhost:5173
NODE_ENV=development
PORT=3000

# Reglas de juego (J.1-J.3, ver docs/spec) - valores por defecto, no secretos
CONTRIBUTION_AMOUNT=1
GOLD_PROBABILITY_DENOMINATOR=100000
POT_MINIMUM=100
