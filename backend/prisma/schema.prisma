// Schema inicial de Prisma — refleja el modelo E de la especificación
// (docs/spec/). NO se ha ejecutado ninguna migración contra una base de
// datos todavía (queda para V0.3, según el encargo de V0.2).
//
// Los dos índices únicos parciales del modelo (one_open_round en
// pot_rounds, one_active_token_per_user en email_verification_tokens) no
// son expresables en el lenguaje de schema de Prisma: se añaden a mano en
// el migration.sql generado, como SQL crudo, cuando se ejecute la primera
// migración en V0.3. Se documentan aquí en comentario para que no se
// pierdan al generar esa migración.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  user
  admin
}

enum SpinResult {
  gold
  no_gold
}

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  passwordHash        String    @map("password_hash")
  role                UserRole  @default(user)
  displayName         String?   @map("display_name")
  emailVerifiedAt      DateTime? @map("email_verified_at")
  failedLoginAttempts  Int       @default(0) @map("failed_login_attempts")
  lockedUntil          DateTime? @map("locked_until")
  createdAt            DateTime  @default(now()) @map("created_at")

  spins                  Spin[]
  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  potWins                 PotWin[]
  idempotencyKeys         IdempotencyKey[]
  roundsWon               PotRound[] @relation("RoundWinner")

  @@map("users")
}

model PotRound {
  id            String    @id @default(uuid())
  initialAmount Decimal   @map("initial_amount")
  startedAt     DateTime  @default(now()) @map("started_at")
  endedAt       DateTime? @map("ended_at")
  finalAmount   Decimal?  @map("final_amount")
  winnerUserId  String?   @map("winner_user_id")
  winnerSpinId  String?   @unique @map("winner_spin_id")

  winnerUser User? @relation("RoundWinner", fields: [winnerUserId], references: [id], onDelete: Restrict)
  winnerSpin Spin? @relation("RoundWinnerSpin", fields: [winnerSpinId], references: [id], onDelete: Restrict)
  spins      Spin[] @relation("RoundSpins")

  // Índice único parcial "una ronda abierta a la vez" (one_open_round):
  //   CREATE UNIQUE INDEX one_open_round ON pot_rounds ((true)) WHERE ended_at IS NULL;
  // Añadir a mano en la migración (Prisma no expresa índices parciales).

  @@map("pot_rounds")
}

model Spin {
  id                 String     @id @default(uuid())
  userId             String     @map("user_id")
  roundId            String     @map("round_id")
  gameDay            DateTime   @map("game_day") @db.Date
  result             SpinResult
  rngAlgorithm       String     @map("rng_algorithm")
  rngRawOutput       BigInt     @map("rng_raw_output")
  rngThreshold       BigInt     @map("rng_threshold")
  rngDrawnAt         DateTime   @map("rng_drawn_at")
  potBefore          Decimal    @map("pot_before")
  potAfter           Decimal    @map("pot_after")
  contributionAmount Decimal    @map("contribution_amount")
  createdAt          DateTime   @default(now()) @map("created_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  round    PotRound  @relation("RoundSpins", fields: [roundId], references: [id], onDelete: Restrict)
  roundWon PotRound? @relation("RoundWinnerSpin")
  win      PotWin?
  idempotencyKeys IdempotencyKey[]

  @@unique([userId, gameDay])
  @@index([userId, gameDay])
  @@index([createdAt])
  @@index([roundId])
  @@map("spins")
}

model PotWin {
  id         String   @id @default(uuid())
  spinId     String   @unique @map("spin_id")
  userId     String   @map("user_id")
  amountWon  Decimal  @map("amount_won")
  wonAt      DateTime @default(now()) @map("won_at")

  spin Spin @relation(fields: [spinId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([wonAt])
  @@map("pot_wins")
}

model IdempotencyKey {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  key       String
  spinId    String   @map("spin_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  spin Spin @relation(fields: [spinId], references: [id], onDelete: Restrict)

  @@unique([userId, key])
  @@map("idempotency_keys")
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  issuedAt   DateTime  @default(now()) @map("issued_at")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  // Índice único parcial "un token activo por usuario" (one_active_token_per_user):
  //   CREATE UNIQUE INDEX one_active_token_per_user ON email_verification_tokens (user_id) WHERE used_at IS NULL;
  // Añadir a mano en la migración (Prisma no expresa índices parciales).

  @@map("email_verification_tokens")
}
